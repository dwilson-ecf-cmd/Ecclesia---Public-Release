{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ecclesia",
  "scopeName": "source.ecclesia",
  "fileTypes": ["ecs"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.double-slash.ecclesia", "match": "//.*$" }] },
    "keywords": { "patterns": [
      { "name": "keyword.control.ecclesia", "match": "\\b(?:if|else|return)\\b" },
      { "name": "storage.type.function.ecclesia", "match": "\\bfn\\b" },
      { "name": "storage.type.variable.ecclesia", "match": "\\blet\\b" }
    ] },
    "functions": { "patterns": [
      { "name": "entity.name.function.ecclesia", "match": "(?<=\\bfn\\s)[A-Za-z_][A-Za-z0-9_]*\\b" },
      { "name": "support.function.ecclesia", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }
    ] },
    "numbers": { "patterns": [{ "name": "constant.numeric.integer.decimal.ecclesia", "match": "\\b(?:0|[1-9][0-9]*)\\b" }] },
    "operators": { "patterns": [
      { "name": "keyword.operator.comparison.ecclesia", "match": "==|!=|<=|>=|<|>" },
      { "name": "keyword.operator.assignment.ecclesia", "match": "=" },
      { "name": "keyword.operator.arithmetic.ecclesia", "match": "[+\\-*/]" }
    ] },
    "identifiers": { "patterns": [{ "name": "variable.other.ecclesia", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }] }
  }
}
