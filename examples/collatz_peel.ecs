// Collatz sequence length (number of terms, including the starting value and the final 1)
// 27 → 112

fn is_even(n) {
    if (n / 2 * 2 == n) {
        return 1;
    } else {
        return 0;
    }
}

fn collatz_length(n) {
    if (n == 1) {
        return 1;
    } else {
        if (is_even(n) == 1) {
            return 1 + collatz_length(n / 2);
        } else {
            return 1 + collatz_length(3 * n + 1);
        }
    }
}

fn main() {
    return collatz_length(27);
}
